ul.nav.nav-tabs(id="productDetailTabs" role="tablist")
    li.nav-item(role="presentation")
        button.nav-link.active(
            id="description-tab"
            data-bs-toggle="tab"
            data-bs-target="#description"
            type="button"
            role="tab"
            aria-controls="description"
            aria-selected="true"
        ) Popis
    li.nav-item(role="presentation")
        button.nav-link(
            id="parameters-tab"
            data-bs-toggle="tab"
            data-bs-target="#parameters"
            type="button"
            role="tab"
            aria-controls="parameters"
            aria-selected="false"
        ) Parametre
    li.nav-item(role="presentation")
        button.nav-link(
            id="variants-tab"
            data-bs-toggle="tab"
            data-bs-target="#variants"
            type="button"
            role="tab"
            aria-controls="variants"
            aria-selected="false"
        ) Varianty
    li.nav-item(role="presentation")
        button.nav-link(
            id="accessories-tab"
            data-bs-toggle="tab"
            data-bs-target="#accessories"
            type="button"
            role="tab"
            aria-controls="accessories"
            aria-selected="false"
        ) Príslušenstvo
