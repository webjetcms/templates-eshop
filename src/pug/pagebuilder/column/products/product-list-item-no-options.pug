div.col-md-6.col-xl-4.mb-4
    div.card.md-product-list-item
        // Štítky
        div.md-product-list-item__badges
            span.md-badge.md-badge--bigger.md-badge--new Novinka
            span.md-badge.md-badge--bigger.md-badge--favourite Obľúbené
            span.md-badge.md-badge--bigger.md-badge--gift + Darček

        // Obrázok
        div.md-product-list-item__image
            img.card-img-top.p-3(src="/assets/images/iphone-big.png" alt="Produktový obrázok")

        div.card-body.md-product-list-item__body
            // Názov produktu
            h5.card-title iPhone 15 Pro 256 GB Space Gray
            p.card-text.text-muted
                | Dvanásta generácia obľúbeného smartfónu vás svojou výbavou určite nesklame. Výkonný procesor zvládne aj náročné operácie v priebehu okamihu a navyše je energeticky nenáročný.

            // Cena a stav skladom
            div.d-flex.justify-content-between.align-items-center.mb-3
                span.h4.fw-bold.text-dark 1 089,00 €
                span.text-success Na sklade >5 ks

            // Tlačidlá
            div.d-flex.justify-content-between.align-items-center
                div.d-flex.align-items-center
                    include number-picker

                    button.btn.btn-primary.me-2
                        i.bi.bi-cart-plus
                        |  Do košíka
                div
                    button.btn.btn-outline-border.just-icon
                        i.bi.bi-heart
