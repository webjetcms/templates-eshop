div.col-12.md-product-list-ranking__item
    .row.w-100
        div.col-md-8.d-flex.flex-column.flex-md-row.align-items-md-center.mb-4.mb-md-0
            div.md-product-list-ranking__number 1.
            div.md-product-list-ranking__image
                a(href="#")
                    img(src="/assets/images/iphone.jpg" alt="Product image")
            div.md-product-list-ranking__info
                h6.md-product-list-ranking__info__name
                    a(href="#") iPhone 15 Pro 256 GB Space Gray
                div.md-product-list-ranking__badge
                    span.md-badge.md-badge--new Novinka
                    span.md-badge.md-badge--gift + Darček
                    span.md-badge.md-badge--favourite Obľúbený
        div.col-6.col-md-2.d-flex.align-items-center.text-md-end
            div.md-product-list-ranking__stock
                // --available or --unavailable
                span.md-product-list-ranking__stock--available Na sklade > 5ks
        div.col-6.col-md-2.d-flex.align-items-center.text-end
            div.md-product-list-ranking__price
                span.md-product-list-ranking__price--actual 1 199,00 €
