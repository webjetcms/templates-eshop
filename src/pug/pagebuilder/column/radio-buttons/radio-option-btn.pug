div.col-12.md-radio-options__item
    input#pickup-point.md-radio-options__radio(type="radio" name="delivery-option")
    label.md-radio-options__label(for="pickup-point")
        div.md-radio-options__circle
        div.md-radio-options__icon
            i.bi.bi-box
        div.md-radio-options__content
            div.left
                div.md-radio-options__content__title Výdajné miesta
                div.md-radio-options__content__description Packeta, Slovenská pošta
                button.md-radio-options__content__button.btn.btn-outline-primary(data-bs-toggle="modal" data-bs-target="#pickupPoint") Vybrať výdajné miesto
            div.right
                div.md-radio-options__content__info k vyzdvihnutiu 20.12.2024
        div.md-radio-options__price 2,99 €
