div.col-12
    div.mb-3
        label.form-label(for="phone") Telefón
        div.input-group
            select.form-select(style="flex: 0 0 88px;")
                option(value="+421" selected) +421
                option(value="+420") +420
                option(value="+48") +48
                option(value="+43") +43
            input.form-control#phone(type="text", placeholder="Zadajte telefónne číslo", style="flex: 1;", name="phone")



