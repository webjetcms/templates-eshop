doctype html
html(class="pg-homepage" lang="sk-SK" data-th-lang="${ninja.temp.lngIso}" data-th-data-browser-name="${ninja.userAgent.browserName}" data-th-data-browser-version="${ninja.userAgent.browserVersion}" data-th-data-device-type="${ninja.userAgent.deviceType}" data-th-data-device-os="${ninja.userAgent.deviceOS}")
    head
        include includes/head.pug
    body.default

        div(class="ly-page-wrapper")
            //header
            header.ly-header(data-iwcm-write="doc_header")
                include pagebuilder/section/header/header
                include pagebuilder/section/navigation/navigation
                include pagebuilder/section/breadcrumb/breadcrumb
            //main content
            main.ly-content-wrapper(data-iwcm-write="doc_data")
                //product detail
                //include pagebuilder/section/products/gallery
                include pagebuilder/section/products/detail
                // banner
                include pagebuilder/section/banner/images-grid-banner
                // slider
                include pagebuilder/section/slider/hp-slider-section
                //terms and conditions
                include pagebuilder/section/terms-and-conditions/terms-and-conditions
                include pagebuilder/section/terms-and-conditions/terms-and-conditions-content-navigation
                include pagebuilder/section/terms-and-conditions/base-info
                //blog-detail
                include pagebuilder/section/blog/blog-hero
                include pagebuilder/section/blog/sections-navigator
                include pagebuilder/section/blog/blog-detail-text
                include pagebuilder/section/blog/blog-image
                include pagebuilder/section/blog/blog-social-share
                include pagebuilder/section/blog/blog-may-interest-you

                // bloglist
                include pagebuilder/section/blog/blog-list
                // contact
                include pagebuilder/section/contact/contact
                include pagebuilder/section/accordion/accordion
                include pagebuilder/section/stores/stores
                include pagebuilder/section/team-members/team-members
                // hero banner
                include pagebuilder/section/complaint/complaint
                include pagebuilder/section/accordion/accordion
                // homepage
                include pagebuilder/section/banner/image-banner
                include pagebuilder/section/products/most-popular
                include pagebuilder/section/products/last-on-stock
                include pagebuilder/section/products/sale
                include pagebuilder/section/products/best-accessories
                include pagebuilder/section/products/favourite
                include pagebuilder/section/products/technologies
                // product list with filter
                include pagebuilder/section/products/list-with-filter
                //include all sections to quickly see all options for layout and PB blocks

                include pagebuilder/section/products/list
                include pagebuilder/section/basket/basket-1
                include pagebuilder/section/basket/basket-2
                include pagebuilder/section/basket/basket-3
                include pagebuilder/section/basket/basket-4

            //footer
            footer.flex-shrink-0.ly-footer(data-iwcm-write="doc_footer")
                include pagebuilder/section/blocks/promo
                include pagebuilder/section/blocks/commercial
                include pagebuilder/section/footer/footer
